# Nisaba environment template. Copy to `.env` and fill the one secret.
# Nisaba does NOT auto-load this file — your shell / scheduled task must
# export it. We refuse to read dotenv because a prior version of this
# code did, which caused silent env override; see docs/TROUBLESHOOTING.md.

# --- REQUIRED ---

# Browser session cookie for chat.openai.com / chatgpt.com, usually
# `__Secure-next-auth.session-token`. If the browser DevTools shows two
# parts `.0` and `.1`, join them with a literal `|||` separator:
# LITOPS_CHATGPT_SESSION_TOKEN=<value_of_.0>|||<value_of_.1>
#
# See docs/BRAVE_COOKIE.md for how to extract it in 30 seconds.
LITOPS_CHATGPT_SESSION_TOKEN=

# --- RECOMMENDED ---

# Pin this to 1 so Nisaba never reads any .env file. We do not need it;
# a stray .env.local in the current directory can silently override this
# very file and point the archiver at a stale cookie. Opt-in to that
# behavior only if you really know you want it.
LITOPS_SKIP_DOTENV=1

# --- OPTIONAL ---

# Throttle between API calls (seconds). 1.0 is conservative; too low
# triggers Cloudflare challenges.
LITOPS_CHATGPT_THROTTLE_SECONDS=1

# Override API base. Default is https://chatgpt.com/backend-api.
# LITOPS_CHATGPT_API_BASE=https://chat.openai.com/backend-api

# Explicit team/enterprise account id if the JWT does not expose one
# (Plus plans do not expose chatgpt_account_id in the JWT).
# LITOPS_CHATGPT_ACCOUNT_ID=
